# Конфигурация сервера — никогда не коммитить!
includes/config.php

# Системные файлы
.DS_Store
Thumbs.db

# Рабочие копии репозитория, которые заводит Claude Code.
# Попав в коммит, они становятся ссылками на несуществующий
# вложенный репозиторий, и GitHub Actions падает с exit code 128.
.claude/worktrees/

# Логи
*.log
error_log

# Временные файлы
*.tmp
*.swp

# Дампы базы — никогда не коммитить!
# В них открытым текстом лежат пароль Kinescope, токен Telegram-бота,
# почты и хеши паролей участников. Закоммитенный дамп уедет на прод
# и будет доступен на скачивание по прямой ссылке.
focuspkp_yoga.sql
focuspkp_yoga.sql.*
*-dump.sql
*.sql.zip
*.sql.gz
